<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- sidecar（Resources/backend 下的可执行文件：dongai-backend、mongod、playwright/driver/node）用的 entitlements，
     由 desktop/signing/sign_mac.sh 使用，electron-builder 不引用。只放这两条，其余一律不加。
     L-09 在 macOS arm64 上用 ad-hoc + Hardened Runtime 逐项实测过：
       - dongai-backend：必须 disable-library-validation，否则加载同目录 Python/.so 报
         "mapping process and mapped file (non-platform) have different Team IDs"；
       - playwright node：必须 allow-unsigned-executable-memory，否则 V8 报 Failed to reserve virtual memory for CodeRange
         （只给 allow-unsigned-executable-memory 就够，不需要 allow-jit）；
       - mongod 7.0.48：什么都不需要，带上也无害（官方包自带的签名里就有 allow-unsigned-executable-memory）。
     注意：以上是 ad-hoc 下的结论。换成真实证书后，自己签的 .so/.dylib 同 Team，disable-library-validation 可能可以去掉，需要拿到证书后再实测。 -->
<plist version="1.0">
<dict>
  <!-- 为什么：Electron 自带的 V8 需要 JIT 申请可写可执行内存；Nuitka 编译出的后端 sidecar 里的
       Playwright 驱动（node，同样是 V8 JIT）也一样。没有这一条，Hardened Runtime 下 Electron 和 node 启动即崩溃。 -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- 为什么：Nuitka 产物在运行时从包内加载 .so/.dylib 扩展模块（Python C 扩展、libpython 等），
       mongod 与 playwright node 也由不同签名/不同 Team 的二进制组成（官方 mongod 带 MongoDB 的签名）；
       Hardened Runtime 默认要求加载的库与主程序同一 Team，不放开会 dlopen 失败。 -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
